    "tokenColors": [
        {
            "scope": [
                "comment",
                "punctuation.definition.comment"
            ],
            "settings": {
                "foreground": "#6c80a8",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "keyword",
                "storage.type",
                "storage.modifier",
                "keyword.control"
            ],
            "settings": {
                "foreground": "#f5a3c7"
            }
        },
        {
            "scope": [
                "keyword.operator",
                "punctuation.accessor"
            ],
            "settings": {
                "foreground": "#7cc8f2"
            }
        },
        {
            "scope": [
                "string",
                "string.quoted",
                "string.template"
            ],
            "settings": {
                "foreground": "#8ee3a8"
            }
        },
        {
            "scope": [
                "constant.character.escape",
                "string.regexp"
            ],
            "settings": {
                "foreground": "#ffb98a"
            }
        },
        {
            "scope": [
                "constant.numeric",
                "constant.language",
                "constant.language.boolean"
            ],
            "settings": {
                "foreground": "#ffd96b"
            }
        },
        {
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call"
            ],
            "settings": {
                "foreground": "#7cc8f2"
            }
        },
        {
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.class",
                "support.type",
                "entity.other.inherited-class"
            ],
            "settings": {
                "foreground": "#ffd96b"
            }
        },
        {
            "scope": [
                "variable",
                "meta.definition.variable"
            ],
            "settings": {
                "foreground": "#e8f0fc"
            }
        },
        {
            "scope": [
                "variable.parameter"
            ],
            "settings": {
                "foreground": "#ffb98a",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "variable.other.property",
                "meta.object-literal.key",
                "support.type.property-name"
            ],
            "settings": {
                "foreground": "#b3bcff"
            }
        },
        {
            "scope": [
                "variable.language.this",
                "variable.language.self",
                "variable.language.super"
            ],
            "settings": {
                "foreground": "#f5a3c7",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "entity.name.tag"
            ],
            "settings": {
                "foreground": "#f5a3c7"
            }
        },
        {
            "scope": [
                "entity.other.attribute-name"
            ],
            "settings": {
                "foreground": "#ffd96b",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "punctuation",
                "meta.brace"
            ],
            "settings": {
                "foreground": "#8ea4c8"
            }
        },
        {
            "scope": [
                "entity.name.namespace",
                "entity.name.package"
            ],
            "settings": {
                "foreground": "#b3bcff"
            }
        },
        {
            "scope": [
                "storage.type.annotation",
                "meta.decorator",
                "punctuation.decorator"
            ],
            "settings": {
                "foreground": "#ffb98a"
            }
        },
        {
            "scope": [
                "markup.heading",
                "entity.name.section"
            ],
            "settings": {
                "foreground": "#7cc8f2",
                "fontStyle": "bold"
            }
        },
        {
            "scope": [
                "markup.bold"
            ],
            "settings": {
                "foreground": "#ffd96b",
                "fontStyle": "bold"
            }
        },
        {
            "scope": [
                "markup.italic"
            ],
            "settings": {
                "foreground": "#f5a3c7",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "markup.inline.raw",
                "markup.fenced_code"
            ],
            "settings": {
                "foreground": "#8ee3a8"
            }
        },
        {
            "scope": [
                "markup.underline.link",
                "string.other.link"
            ],
            "settings": {
                "foreground": "#7cc8f2"
            }
        },
        {
            "scope": [
                "markup.inserted"
            ],
            "settings": {
                "foreground": "#8ee3a8"
            }
        },
        {
            "scope": [
                "markup.deleted"
            ],
            "settings": {
                "foreground": "#ff8a9a"
            }
        },
        {
            "scope": [
                "invalid"
            ],
            "settings": {
                "foreground": "#ff8a9a"
            }
        }
    ]
}
